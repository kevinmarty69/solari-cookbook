# SaaS server. Without both secrets, sample/import/history/share still work and
# live verification fails closed without allocating Solari resources.
PORT=3000
SOLARI_API_KEY=
DONELEDGER_LIVE_ACCESS_CODE=

# Legacy seeded proof CLI. Fixture mode is the safe default.
DONELEDGER_MODE=fixture

# Live mode is explicit: npm run live
DONELEDGER_WORKER_URL=https://your-dolibarr.example
DONELEDGER_VERIFIER_URL=https://your-dolibarr.example
DONELEDGER_WORKER_PROFILE_ID=
DONELEDGER_VERIFIER_PROFILE_ID=
DONELEDGER_WORKER_USERNAME=
DONELEDGER_WORKER_PASSWORD=
DONELEDGER_VERIFIER_USERNAME=
DONELEDGER_VERIFIER_PASSWORD=
